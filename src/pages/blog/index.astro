---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';

function datePath(date: Date) {
  const yyyy = date.getUTCFullYear();
  const mm = String(date.getUTCMonth() + 1).padStart(2, '0');
  const dd = String(date.getUTCDate()).padStart(2, '0');
  return `${yyyy}/${mm}/${dd}`;
}

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog" description="The TROi blog: observations on architecture, capabilities, teams and transformation from consulting work — the archive behind Organizational Flow.">
  <section class="hero">
    <p class="kicker">Archive</p>
    <h1>Blog</h1>
    <p class="lede">
      Observations from the work, as they happened. Untouched — where an idea here grew into something more,
      that chapter is linked below the post.
    </p>
    <div class="horizon"></div>
  </section>

  <main class="reading" id="main">
    <ul style="list-style:none; padding:0; margin:0 auto; max-width:var(--max);">
      {posts.map((post) => (
        <li style="border-top:1px solid var(--mist); padding:1.4rem 0;">
          <a href={`/blog/${datePath(post.data.date)}/${post.id}/`} style="text-decoration:none; color:inherit;">
            <p class="marginalia-title" style="font-size:1.15rem;">{post.data.title}</p>
          </a>
          <p style="font-family:'Space Mono', monospace; font-size:0.68rem; letter-spacing:0.06em; text-transform:uppercase; color:var(--bark); margin:0.4rem 0 0;">
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
            {post.data.category && ` — ${post.data.category}`}
          </p>
        </li>
      ))}
    </ul>
    <p style="margin:1.6rem auto 0; max-width:var(--max); border-top:1px solid var(--mist); padding-top:1.2rem; font-family:'Space Mono', monospace; font-size:0.72rem; letter-spacing:0.06em; text-transform:uppercase;">
      <a href="/blog/rss.xml" type="application/rss+xml">Subscribe via RSS</a>
    </p>
  </main>

  <Footer label="TROi — blog archive" />
</BaseLayout>
