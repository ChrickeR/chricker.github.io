  /* ---------- Print ---------- */
  @media print {
    .no-print, .site-header, .site-footer, .skip-link, .theme-toggle { display: none !important; }

    /* ---------- Book typography ----------
       10.5pt on 1.5 across a 112mm measure. Smaller than the A4 setting this
       replaced, because the page is smaller and the measure narrower — the
       ratio is what makes it read as a book rather than as a website that
       happened to be printed. */
    /* ---------- Grayscale palette ----------
       The book prints in black and white, and the site's colours are
       differentiated mostly by hue (moss vs bark vs gold read as clearly
       different to the eye but land within about ten points of each other
       once desaturated). This ramp replaces every printed colour with a
       lightness step wide enough to still tell roles apart with the hue
       gone — trunk darker than root, root darker than the sap/light accent,
       accent darker than the soil line, so what read as green/brown/gold
       reads as dark/mid/light gray instead. */
    html {
      --pr-ink: #1a1a1a;    /* body text, the cut in the girdled tree, primary labels */
      --pr-strong: #3d3d3d; /* eyebrows, kickers, trunk and canopy strokes */
      --pr-label: #595959;  /* the flow model's readable circulation words */
      --pr-muted: #555555;  /* meta text — captions, edition lines, sub-labels */
      --pr-soft: #6b6b6b;   /* root strokes — lightens further via their own opacity */
      --pr-accent: #767676; /* sap and light — decorative circulation cues */
      --pr-line: #a3a3a3;   /* soil line, leader lines — kept subtle but visible */
      --pr-border: #cccccc; /* hairline rules between entries */
    }
    html, body {
      background: #fff !important;
      color: var(--pr-ink) !important;
      /* 10.5 / 14 pt — letters 10.5pt, baseline to baseline 14pt. Source
         Serif 4 is classical without being antique: clear serifs, calm over
         long stretches, and it reads as editorial rather than as a document. */
      font-size: 10.5pt;
      line-height: 1.3333;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .print-doc { max-width: none; padding: 0; margin: 0; }

    /* Paragraphs are set with space rather than indents: this manuscript
       leans on bold signpost lines between paragraphs, and first-line indents
       fight them. Hyphenation on, because a narrow measure without it leaves
       rivers. */
    .prose p, .thanks-body, .back-blurb {
      margin: 0 0 0.62em;
      hyphens: auto;
      -webkit-hyphens: auto;
    }
    .prose { text-align: left; }

    /* ---------- The book's own pages ---------- */
    .book-only { display: block; }
    .book-page { break-after: page; page-break-after: always; }
    /* The back cover is the last leaf of the document — forcing a break
       after it, same as every other book-page, prints a genuinely blank page
       behind it, which then confuses which page is really last. */
    .book-back-cover { break-after: avoid; page-break-after: avoid; }
    .book-blank { display: block; height: 1px; }

    .book-cover,
    .book-back-cover {
      page: cover;
    }
    .book-cover,
    .book-edition-page,
    .book-back-cover {
      display: flex;
      flex-direction: column;
      min-height: 181mm;
      margin: 0;
      padding: 0;
    }

    /* Front cover: title block high, mark in the middle, name at the foot. */
    .cover { text-align: center; }
    .book-cover { min-height: 181mm; justify-content: space-between; }
    .cover-top { padding-top: 8mm; }
    .cover-title { font-size: 44pt; line-height: 1; }
    .cover-subtitle { font-size: 19pt; margin-top: 2mm; }
    .cover-sub { font-size: 11pt; max-width: 80mm; margin: 6mm auto 0; }
    .cover-eyebrow { font-size: 8pt; letter-spacing: 0.16em; margin-bottom: 8mm; }
    /* The hillside sits a little below the optical centre and takes most of
       the measure — one tree per organization, no two alike, which is the
       whole model before a word of it has been read. */
    .cover-mark {
      max-width: 116mm;
      margin: 0 auto;
      padding-bottom: 4mm;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    /* The generic .part-opener cap below is for part openers; the cover mark
       takes the full measure. The drawing carries its own margin inside the
       viewBox, so it still reads as a small mark rather than a banner. */
    .cover-mark .part-opener { max-width: none; margin: 0; }
    .cover-foot-block { padding-bottom: 4mm; }
    .cover-rule { margin: 0 auto 5mm; }
    .cover-author { font-size: 12pt; }
    .cover-meta { font-size: 7.5pt; }

    /* Edition page: everything sits at the foot of the leaf. */
    .book-edition-page { justify-content: flex-end; text-align: left; }
    .edition-block { max-width: 100mm; }

    /* Back cover. */
    .book-back-cover { min-height: 181mm; justify-content: space-between; text-align: center; }
    .back-top { padding-top: 10mm; }
    .back-blurb { font-size: 9.5pt; line-height: 1.55; }
    .back-foot { padding-bottom: 2mm; }

    /* ---------- Sections and openings ---------- */
    .page { page-break-before: always; break-before: page; margin: 0 0 1.5rem; }
