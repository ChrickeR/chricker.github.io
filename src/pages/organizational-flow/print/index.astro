    .toc-line, .toc-group { page-break-inside: avoid; break-inside: avoid; }

    .cover-eyebrow, .part-eyebrow, .toc-part-title,
    .back-eyebrow { color: var(--pr-strong) !important; }
    .part-question { color: var(--pr-strong) !important; }
    .cover-sub, .front-lede, .chapter-print-dek, .credit-relation, .credit-where, .part-intro p,
    .cover-meta, .cover-foot, .print-note, .appendix-list, .colophon,
    .edition-line, .edition-note, .back-author-line, .back-url { color: var(--pr-muted) !important; }
    .edition-imprint { border-color: var(--pr-border) !important; }
    .edition-imprint .edition-line { font-size: 6.5pt; line-height: 1.7; }
    .cover-rule, .back-rule { background: var(--pr-muted) !important; }
    .print-notes-label { color: var(--pr-strong) !important; }
    .toc-line, .credit, .print-notes, .colophon { border-color: var(--pr-border) !important; }
    /* The contents is a lookup table, not reading matter — it can sit a step
       below the body size without costing anything. */
    .toc-line { font-size: 9pt; padding: 0.3rem 0; }
    .toc-part-title { font-size: 6.5pt; }
    .toc-num { font-size: 6.5pt; min-width: 1.6rem; }
    .toc-topic { color: var(--pr-muted) !important; font-size: 6pt; }
