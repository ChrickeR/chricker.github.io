---
// Three faces and a counter. The counts live in a free, account-less counter
// service (abacus.jasoncameron.dev), because the site is static and the
// alternative was either a backend to maintain or a number only I can see.
// If it is unreachable the vote still registers visually and the numbers
// simply stay hidden.
interface Props {
  tool: string;
}
const { tool } = Astro.props;
---

<section class="vote" data-tool={tool} aria-labelledby={`vote-${tool}`}>
  <p class="marginalia-label" id={`vote-${tool}`}>Is this worth building?</p>
  <p class="vote-line">
    One press. No name, no address, no follow-up — it tells me whether to take this further or let it
    mature a while longer.
  </p>

  <div class="faces">
    <button type="button" class="face face-good" data-choice="good" aria-label="Yes, build it">
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="17" />
        <circle class="eye" cx="14" cy="16" r="1.9" />
        <circle class="eye" cx="26" cy="16" r="1.9" />
        <path d="M12 24 Q20 31 28 24" />
      </svg>
      <span class="count" data-count="good">·</span>
    </button>

    <button type="button" class="face face-ok" data-choice="ok" aria-label="Maybe">
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="17" />
        <circle class="eye" cx="14" cy="16" r="1.9" />
        <circle class="eye" cx="26" cy="16" r="1.9" />
        <path d="M13 26 L27 26" />
      </svg>
      <span class="count" data-count="ok">·</span>
    </button>

    <button type="button" class="face face-bad" data-choice="bad" aria-label="No, leave it">
      <svg viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="17" />
        <circle class="eye" cx="14" cy="16" r="1.9" />
        <circle class="eye" cx="26" cy="16" r="1.9" />
        <path d="M12 28 Q20 21 28 28" />
      </svg>
      <span class="count" data-count="bad">·</span>
    </button>
  </div>

  <p class="vote-thanks" hidden>Noted. Thank you.</p>
</section>

<script>
  const API = 'https://abacus.jasoncameron.dev';
  const NS = 'troi-se';

  document.querySelectorAll<HTMLElement>('.vote').forEach((box) => {
    const tool = box.dataset.tool;
    if (!tool) return;
    const key = `troi-vote-${tool}`;
    const buttons = box.querySelectorAll<HTMLButtonElement>('.face');
    const thanks = box.querySelector<HTMLElement>('.vote-thanks');

    const paint = (choice: string, value: number) => {
      const el = box.querySelector<HTMLElement>(`[data-count="${choice}"]`);
      if (el && Number.isFinite(value)) el.textContent = String(value);
    };

    const read = async (choice: string) => {
      try {
        const res = await fetch(`${API}/get/${NS}/${tool}-${choice}`);
        // A key only exists once somebody has pressed it. No key is a real
        // zero, not an outage — the two should not look the same.
        if (res.status === 404) return paint(choice, 0);
        if (!res.ok) return;
        const data = await res.json();
        paint(choice, data.value);
      } catch {
        /* counter unavailable; the dot stays */
      }
    };

    ['good', 'ok', 'bad'].forEach(read);

    let voted: string | null = null;
    try {
      voted = localStorage.getItem(key);
    } catch {
      /* private mode */
    }

    const settle = (choice: string) => {
      buttons.forEach((b) => {
        b.classList.toggle('is-chosen', b.dataset.choice === choice);
        b.disabled = true;
      });
      if (thanks) thanks.hidden = false;
    };

    if (voted) settle(voted);

    buttons.forEach((button) => {
      button.addEventListener('click', async () => {
        const choice = button.dataset.choice;
        if (!choice) return;
        settle(choice);
        try {
          localStorage.setItem(key, choice);
        } catch {
          /* private mode */
        }
        try {
          const res = await fetch(`${API}/hit/${NS}/${tool}-${choice}`);
          if (res.ok) {
            const data = await res.json();
            paint(choice, data.value);
          }
        } catch {
          /* the press still counted for the person who made it */
        }
      });
    });
  });
</script>

<style>
  .vote {
    --face-good: #5C8055;
    --face-ok: #B4884A;
    --face-bad: #A0563F;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--mist);
  }
  .vote-line {
    margin: 0;
    font-size: 0.95rem;
    color: var(--bark);
    max-width: 32rem;
  }
  .faces {
    display: flex;
    gap: 1.6rem;
    margin-top: 1.2rem;
  }
  .face {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.5rem;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: 'Space Mono', monospace;
    font-size: 0.82rem;
    color: var(--bark);
  }
  .face svg {
    width: 40px;
    height: 40px;
    fill: none;
    stroke: var(--mist);
    stroke-width: 2;
    stroke-linecap: round;
    transition: stroke 0.15s ease, transform 0.15s ease;
  }
  .face svg .eye {
    fill: var(--mist);
    stroke: none;
    transition: fill 0.15s ease;
  }
  .face:hover:not(:disabled) svg,
  .face.is-chosen svg {
    transform: translateY(-2px);
  }
  .face-good:hover:not(:disabled) svg,
  .face-good.is-chosen svg {
    stroke: var(--face-good);
  }
  .face-good:hover:not(:disabled) svg .eye,
  .face-good.is-chosen svg .eye {
    fill: var(--face-good);
  }
  .face-ok:hover:not(:disabled) svg,
  .face-ok.is-chosen svg {
    stroke: var(--face-ok);
  }
  .face-ok:hover:not(:disabled) svg .eye,
  .face-ok.is-chosen svg .eye {
    fill: var(--face-ok);
  }
  .face-bad:hover:not(:disabled) svg,
  .face-bad.is-chosen svg {
    stroke: var(--face-bad);
  }
  .face-bad:hover:not(:disabled) svg .eye,
  .face-bad.is-chosen svg .eye {
    fill: var(--face-bad);
  }
  .face:disabled {
    cursor: default;
  }
  .face:disabled:not(.is-chosen) {
    opacity: 0.55;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .vote {
      --face-good: #8CB584;
      --face-ok: #D6A85F;
      --face-bad: #C9866B;
    }
  }
  :root[data-theme='dark'] .vote {
    --face-good: #8CB584;
    --face-ok: #D6A85F;
    --face-bad: #C9866B;
  }

  .vote-thanks {
    margin: 0.9rem 0 0;
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--moss);
  }
</style>
