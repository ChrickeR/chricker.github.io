---
// Pre-recorded narration (edge-tts, generated by scripts/generate-audio.py —
// see public/audio/). One MP3 per chapter rather than one long file: jumping
// to a chapter is just switching src, pause/resume is the native <audio>
// element, and no single file is ever more than a few MB.
interface Chapter {
  slug: string;
  title: string;
  /** Seconds. From src/data/audio-durations.json, generated alongside the
   *  audio itself — shown next to each chapter so a reader can gauge the
   *  jump before taking it. */
  duration?: number;
}
interface Props {
  chapters: Chapter[];
  /** Pre-select this chapter (by slug) on load, without autoplaying — used
   *  on a chapter page so the player opens ready to play that chapter
   *  rather than "Not started." Takes priority over a resumed position. */
  initialSlug?: string;
  /** "Listen to the paper" on the one-page edition; "Listen to this chapter"
   *  makes more sense standing inside a single chapter. */
  label?: string;
}
const { chapters, initialSlug, label = 'Listen to the paper' } = Astro.props;
const chaptersJson = JSON.stringify(chapters);
---

<div class="audio-player" data-audio-player data-chapters={chaptersJson} data-initial-slug={initialSlug} hidden>
  <div class="ap-bar">
    <button type="button" class="ap-playpause" data-ap-playpause aria-label="Play">
      <span data-ap-icon aria-hidden="true">▶</span>
    </button>
    <div class="ap-now">
      <span class="ap-now-label">{label}</span>
      <span class="ap-now-title" data-ap-title>Not started</span>
    </div>
    <button type="button" class="ap-skip" data-ap-prev aria-label="Previous chapter" disabled>⏮</button>
    <button type="button" class="ap-skip" data-ap-next aria-label="Next chapter" disabled>⏭</button>
    <span class="ap-time" data-ap-time>&nbsp;</span>
    <label class="ap-select">
      <span class="ap-select-label">Speed</span>
      <select data-ap-rate aria-label="Playback speed">
        <option value="0.9">0.9×</option>
        <option value="1" selected>1.0×</option>
        <option value="1.15">1.15×</option>
        <option value="1.25">1.25×</option>
        <option value="1.5">1.5×</option>
      </select>
    </label>
  </div>
  <input type="range" class="ap-scrub" data-ap-seek min="0" max="100" value="0" step="0.1"
    aria-label="Position in this chapter" disabled />
  <details class="ap-chapters">
    <summary>Jump to a chapter</summary>
    <ol data-ap-list></ol>
  </details>
  <p class="ap-note">Narrated with Microsoft's neural voice, not me — a recording.</p>
  <audio data-ap-audio preload="none"></audio>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-audio-player]');
  if (root) {
    const chapters: { slug: string; title: string }[] = JSON.parse(root.dataset.chapters || '[]');
    if (chapters.length) {
      root.hidden = false;

      const audio = root.querySelector<HTMLAudioElement>('[data-ap-audio]')!;
      const playBtn = root.querySelector<HTMLButtonElement>('[data-ap-playpause]')!;
      const icon = root.querySelector<HTMLElement>('[data-ap-icon]')!;
      const titleEl = root.querySelector<HTMLElement>('[data-ap-title]')!;
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-ap-prev]')!;
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-ap-next]')!;
      const timeEl = root.querySelector<HTMLElement>('[data-ap-time]')!;
      const rateSel = root.querySelector<HTMLSelectElement>('[data-ap-rate]')!;
      const list = root.querySelector<HTMLElement>('[data-ap-list]')!;
      const seek = root.querySelector<HTMLInputElement>('[data-ap-seek]')!;

      const POS_KEY = 'ap-position';
      const RATE_KEY = 'ap-rate';
      let idx = -1;
      let seeking = false;

      chapters.forEach((c, i) => {
        const li = document.createElement('li');
        li.className = 'ap-list-row';
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'ap-list-item';
        b.addEventListener('click', () => load(i, true));
        const titleSpan = document.createElement('span');
        titleSpan.className = 'ap-list-title';
        titleSpan.textContent = c.title;
        b.appendChild(titleSpan);
        if (c.duration) {
          const t = document.createElement('span');
          t.className = 'ap-list-duration';
          t.textContent = fmt(c.duration);
          b.appendChild(t);
        }
        const a = document.createElement('a');
        a.className = 'ap-list-read';
        // Preface has no page of its own — it's the top of the landing page.
        a.href = c.slug === 'preface' ? '/organizational-flow/' : '/organizational-flow/' + c.slug + '/';
        a.textContent = 'Read';
        li.appendChild(b);
        li.appendChild(a);
        list.appendChild(li);
      });

      function fmt(s: number) {
        if (!isFinite(s) || s < 0) return '0:00';
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return m + ':' + String(sec).padStart(2, '0');
      }

      function updateTime() {
        timeEl.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
        if (!seeking && isFinite(audio.duration)) {
          seek.max = String(audio.duration);
          seek.value = String(audio.currentTime);
        }
      }

      function highlight() {
        [...list.children].forEach((li, i) => {
          li.querySelector('button')!.classList.toggle('is-current', i === idx);
        });
      }

      function savePosition() {
        if (idx < 0) return;
        try {
          localStorage.setItem(POS_KEY, JSON.stringify({ slug: chapters[idx].slug, t: audio.currentTime }));
        } catch {}
      }

      function load(i: number, autoplay: boolean, atTime = 0) {
        if (i < 0 || i >= chapters.length) return;
        idx = i;
        const c = chapters[i];
        audio.src = '/audio/' + c.slug + '.mp3';
        audio.currentTime = atTime;
        titleEl.textContent = c.title;
        prevBtn.disabled = i === 0;
        nextBtn.disabled = i === chapters.length - 1;
        seek.disabled = false;
        seek.value = String(atTime);
        highlight();
        if (autoplay) audio.play().catch(() => {});
      }

      playBtn.addEventListener('click', () => {
        if (idx < 0) {
          // Resume where a previous visit left off, if that chapter still exists.
          let start = 0;
          let startI = 0;
          try {
            const saved = JSON.parse(localStorage.getItem(POS_KEY) || 'null');
            if (saved) {
              const i = chapters.findIndex((c) => c.slug === saved.slug);
              if (i >= 0) { startI = i; start = saved.t || 0; }
            }
          } catch {}
          load(startI, true, start);
          return;
        }
        if (audio.paused) audio.play().catch(() => {});
        else audio.pause();
      });

      prevBtn.addEventListener('click', () => load(idx - 1, true));
      nextBtn.addEventListener('click', () => load(idx + 1, true));

      audio.addEventListener('play', () => { icon.textContent = '❙❙'; playBtn.setAttribute('aria-label', 'Pause'); });
      audio.addEventListener('pause', () => { icon.textContent = '▶'; playBtn.setAttribute('aria-label', 'Play'); savePosition(); });
      audio.addEventListener('timeupdate', () => { updateTime(); if (Math.floor(audio.currentTime) % 5 === 0) savePosition(); });
      audio.addEventListener('loadedmetadata', updateTime);
      audio.addEventListener('ended', () => {
        if (idx < chapters.length - 1) load(idx + 1, true);
        else savePosition();
      });

      // Live time display while dragging; the seek itself lands on release
      // (change) rather than every step (input), so scrubbing doesn't spam
      // the audio element with currentTime writes.
      seek.addEventListener('pointerdown', () => { seeking = true; });
      seek.addEventListener('input', () => {
        timeEl.textContent = fmt(parseFloat(seek.value)) + ' / ' + fmt(audio.duration);
      });
      seek.addEventListener('change', () => {
        audio.currentTime = parseFloat(seek.value);
        seeking = false;
        savePosition();
      });

      let rate = 1;
      try {
        const stored = parseFloat(localStorage.getItem(RATE_KEY) || '');
        if (stored >= 0.5 && stored <= 2) rate = stored;
      } catch {}
      rateSel.value = String(rate);
      audio.playbackRate = rate;
      rateSel.addEventListener('change', () => {
        rate = parseFloat(rateSel.value) || 1;
        audio.playbackRate = rate;
        try { localStorage.setItem(RATE_KEY, String(rate)); } catch {}
      });

      window.addEventListener('pagehide', savePosition);
      window.addEventListener('beforeunload', savePosition);

      // A chapter page pre-selects its own chapter — ready to press play,
      // no autoplay, and it wins over a resumed position from elsewhere.
      const initialSlug = root.dataset.initialSlug;
      if (initialSlug) {
        const i = chapters.findIndex((c) => c.slug === initialSlug);
        if (i >= 0) load(i, false);
      }
    }
  }
</script>

<style is:global>
  /* Global rather than scoped: the chapter list and its rows are built by
     the script above via document.createElement, and Astro's scoped-CSS
     attribute is only stamped onto elements present in this file's own
     template — it never reaches anything created at runtime. */
  .audio-player {
    max-width: var(--max);
    margin: 0 auto 2rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--mist);
    border-radius: 0.6rem;
    background: var(--card);
  }
  .ap-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }
  /* Scrub bar — a native range input restyled to a thin track. Full custom
     styling needs both -webkit- and -moz- rules; there is no shorthand that
     covers both engines. */
  .ap-scrub {
    display: block;
    width: 100%;
    margin: 0.7rem 0 0;
    height: 1rem;
    appearance: none;
    background: transparent;
    cursor: pointer;
  }
  .ap-scrub:disabled { cursor: default; opacity: 0.5; }
  .ap-scrub::-webkit-slider-runnable-track {
    height: 3px;
    background: var(--mist);
    border-radius: 2px;
  }
  .ap-scrub::-moz-range-track {
    height: 3px;
    background: var(--mist);
    border-radius: 2px;
  }
  .ap-scrub::-webkit-slider-thumb {
    appearance: none;
    margin-top: -5px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--moss);
    border: 2px solid var(--card);
    box-shadow: 0 0 0 1px var(--moss);
  }
  .ap-scrub::-moz-range-thumb {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--moss);
    border: 2px solid var(--card);
    box-shadow: 0 0 0 1px var(--moss);
  }
  .ap-scrub:disabled::-webkit-slider-thumb { background: var(--bark); box-shadow: 0 0 0 1px var(--bark); }
  .ap-scrub:disabled::-moz-range-thumb { background: var(--bark); box-shadow: 0 0 0 1px var(--bark); }
  .ap-playpause {
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--moss);
    background: var(--moss);
    color: var(--paper);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .ap-playpause:hover { background: var(--ink); border-color: var(--ink); }
  .ap-now {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1 1 12rem;
  }
  .ap-now-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bark);
  }
  .ap-now-title {
    font-family: 'Fraunces', serif;
    font-size: 0.98rem;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ap-skip {
    flex: none;
    background: none;
    border: 1px solid var(--mist);
    border-radius: 50%;
    width: 1.9rem;
    height: 1.9rem;
    font-size: 0.7rem;
    color: var(--bark);
    cursor: pointer;
  }
  .ap-skip:hover:not(:disabled) { color: var(--moss); border-color: var(--moss); }
  .ap-skip:disabled { opacity: 0.35; cursor: default; }
  .ap-time {
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    color: var(--bark);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ap-select {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bark);
  }
  .ap-select select {
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    color: var(--bark);
    background: none;
    border: 1px solid var(--mist);
    border-radius: 2rem;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
  }
  .ap-chapters {
    margin-top: 0.8rem;
  }
  .ap-chapters summary {
    cursor: pointer;
    list-style: none;
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bark);
  }
  .ap-chapters summary::-webkit-details-marker { display: none; }
  .ap-chapters summary::before { content: "▸ "; }
  .ap-chapters[open] summary::before { content: "▾ "; }
  .ap-chapters summary:hover { color: var(--ink); }
  .ap-chapters ol {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    max-height: 22rem;
    overflow-y: auto;
    columns: 2;
    column-gap: 2rem;
    border-bottom: 1px solid var(--mist);
  }
  .ap-list-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    border-top: 1px solid var(--mist);
    break-inside: avoid;
  }
  .ap-list-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex: 1 1 auto;
    min-width: 0;
    text-align: left;
    appearance: none;
    background: none;
    border: none;
    border-radius: 0;
    padding: 0.62rem 0;
    font-family: 'Fraunces', serif;
    font-size: 0.95rem;
    color: var(--ink);
    cursor: pointer;
  }
  .ap-list-title {
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ap-list-item.is-current .ap-list-title::before { content: "▸ "; }
  .ap-list-duration {
    flex: none;
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    color: var(--bark);
    font-variant-numeric: tabular-nums;
  }
  .ap-list-item:hover { color: var(--moss); }
  .ap-list-item.is-current { color: var(--gold); }
  .ap-list-read {
    flex: none;
    align-self: center;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bark);
    text-decoration: none;
  }
  .ap-list-read:hover { color: var(--moss); }
  .ap-note {
    margin: 0.8rem 0 0;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.03em;
    line-height: 1.6;
    color: var(--bark);
  }
  @media (max-width: 560px) {
    .ap-chapters ol { columns: 1; }
  }
  @media print {
    .audio-player { display: none; }
  }
</style>
