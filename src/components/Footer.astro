---
interface Props {
  label?: string;
  folio?: string;
}
import OrderDialog from './OrderDialog.astro';
import {
  copyrightYear,
  pdfDownloadPublic,
  bookPdfPath,
  bookPdfFilename,
  rightsHolder,
  licenceShort,
  licenceUrl,
} from '../data/print-edition';

const { label = 'TROi — an ongoing work', folio } = Astro.props;

// From the build clock, so it is right next January without anybody
// remembering — the same source the book's edition page uses.
const year = copyrightYear();

// The back matter reaches readers through the contents and through the paper
// itself; repeating all of it on every page of the site was just more to read
// past. Version History stays, because nothing else points at it.
const backMatter = [
  { href: '/organizational-flow/version-history/', label: 'Version History' },
];
---

<footer class="site-footer">
  <span>{label}</span>
  {folio && <span class="folio">{folio}</span>}
  <nav class="site-footer-links" aria-label="Appendix">
    {backMatter.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>
  <span class="site-footer-legal">
    <button class="site-footer-buy" type="button" data-open-order>Get your copy</button>
    {/* The PDF is not advertised anywhere. It is the copyright line itself —
        no underline, no hover colour, nothing that reads as a link. Anyone who
        goes looking finds it; nobody else notices it is there. */}
    {pdfDownloadPublic ? (
      <a
        class="site-footer-copyright site-footer-egg"
        href={bookPdfPath}
        download={bookPdfFilename()}
        data-download-paper
      >© {year} {rightsHolder}</a>
    ) : (
      <span class="site-footer-copyright">© {year} {rightsHolder}</span>
    )}
    <a href={licenceUrl} rel="license noopener" target="_blank">{licenceShort}</a>
    <a href="/privacy/">Privacy</a>
    <a href="/ai-transparency/">AI Transparency</a>
  </span>
</footer>

{/* Lives with the footer rather than on one page, so Buy a copy works
    wherever the footer does. */}
<OrderDialog />
