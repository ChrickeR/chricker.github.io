---
// Plain share links — no third-party scripts, no tracking, nothing loaded until
// somebody clicks. The privacy page promises no cookie banner, and a sharing
// widget would break that promise quietly. Icons are inline SVG in the text
// colour; each link keeps its name for screen readers and as a tooltip.
import { SITE_URL } from '../data/site';

interface Props {
  title: string;
  /** Defaults to the current page. */
  path?: string;
  label?: string;
}

const { title, path = Astro.url.pathname, label = 'Share' } = Astro.props;
const url = new URL(path, SITE_URL).href;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const icons = {
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  x: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
  facebook:
    'M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.026 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.514c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z',
};

const links = [
  { name: 'Share on LinkedIn', icon: icons.linkedin, href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
  { name: 'Share on X', icon: icons.x, href: `https://twitter.com/intent/tweet?url=${u}&text=${t}` },
  { name: 'Share on Facebook', icon: icons.facebook, href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
];
---

<div class="share-links" data-share-url={url}>
  <span class="share-label">{label}</span>
  {links.map((l) => (
    <a class="share-icon" href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.name} title={l.name}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={l.icon} /></svg>
    </a>
  ))}
  <a class="share-icon" href={`mailto:?subject=${t}&body=${u}`} aria-label="Share by email" title="Share by email">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
      <path d="m3 6 9 7 9-7" />
    </svg>
  </a>
  <button type="button" class="share-icon share-copy" data-share-copy aria-label="Copy link" title="Copy link">
    <svg class="icon-link" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" />
      <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" />
    </svg>
    <svg class="icon-done" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m5 12.5 4.5 4.5L19 7.5" />
    </svg>
  </button>
  <span class="share-status" role="status" aria-live="polite"></span>
</div>

<style>
  .share-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    max-width: var(--max);
    margin: 2rem 0 0;
  }
  .share-label {
    margin-right: 0.3rem;
    font-family: 'Space Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bark);
  }
  .share-icon {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 1px solid var(--mist);
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .share-icon svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .share-icon:hover,
  .share-icon:focus-visible {
    color: var(--moss);
    border-color: var(--moss);
  }
  .share-copy .icon-done {
    display: none;
  }
  .share-copy.copied .icon-link {
    display: none;
  }
  .share-copy.copied .icon-done {
    display: block;
  }
  .share-copy.copied {
    color: var(--moss);
    border-color: var(--moss);
  }
  .share-status {
    font-family: 'Space Mono', monospace;
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--moss);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.share-links').forEach((box) => {
    const button = box.querySelector<HTMLButtonElement>('[data-share-copy]');
    const status = box.querySelector<HTMLElement>('.share-status');
    if (!button) return;
    const url = box.dataset.shareUrl ?? location.href;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        button.classList.add('copied');
        if (status) status.textContent = 'Link copied';
      } catch {
        if (status) status.textContent = url;
      }
      setTimeout(() => {
        button.classList.remove('copied');
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>
