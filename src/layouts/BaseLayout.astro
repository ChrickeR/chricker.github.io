---
import Header from '../components/Header.astro';
import '../styles/global.css';
import { SITE_URL, baseGraph, defaultOgImage, author } from '../data/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Replaces the default "{title} — TROi" when a page needs a fuller title. */
  fullTitle?: string;
  lang?: string;
  /** Alternate-language versions: { hreflang: path }. */
  alternates?: Record<string, string>;
  ogType?: 'website' | 'article' | 'book' | 'profile';
  ogImage?: string;
  /** Page-specific schema.org nodes, merged into the site-wide graph. */
  jsonLd?: object[];
  /** ISO dates for article-type pages. */
  published?: string;
  modified?: string;
}

const {
  title,
  description = 'Christoffer Råsten, enterprise architect in Stockholm: architecture, organizational design and Organizational Flow.',
  noindex = false,
  fullTitle,
  lang = 'en',
  alternates,
  ogType = 'website',
  ogImage = defaultOgImage,
  jsonLd = [],
  published,
  modified,
} = Astro.props;

// Search results show about sixty characters; a longer title loses the brand
// rather than the subject.
const pageTitle = fullTitle ?? (`${title} — TROi`.length <= 60 ? `${title} — TROi` : title);
// Canonical is always the trailing-slash form Astro builds, without query or hash.
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const imageUrl = new URL(ogImage, SITE_URL).href;
const graph = { '@context': 'https://schema.org', '@graph': [...baseGraph(), ...jsonLd] };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author.name} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {!noindex && <link rel="canonical" href={canonical} />}
    {alternates && Object.entries(alternates).map(([hreflang, path]) => (
      <link rel="alternate" hreflang={hreflang} href={new URL(path, SITE_URL).href} />
    ))}
    <link rel="alternate" type="application/rss+xml" title="TROi — blog" href="/blog/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:site_name" content="TROi" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content={lang === 'sv' ? 'sv_SE' : 'en_GB'} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {ogType === 'article' && <meta property="article:author" content={author.linkedin} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#1B1F1A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=Space+Mono&display=swap"
      rel="stylesheet"
    />

    <!-- Cronitor RUM -->
    <script async src="https://rum.cronitor.io/script.js"></script>
    <script is:inline>
      window.cronitor = window.cronitor || function() { (window.cronitor.q = window.cronitor.q || []).push(arguments); };
      cronitor('config', { clientKey: 'd7a87eeb44f0d4b21fc879fe57c5d634' });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
  </body>
</html>
